{
  "name": "@splitsense/video",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "voice": "node --env-file-if-exists=../.env.local scripts/voice.mjs",
    "terminal": "node scripts/terminal.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Paddock out/paddock.mp4",
    "still": "remotion still src/index.ts Paddock",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "^19.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
