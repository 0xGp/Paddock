{
  "name": "splitsense",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:live": "pnpm --filter @splitsense/chain test:live",
    "sui:keys": "node scripts/sui-keys.mjs",
    "settle:smoke": "node --env-file=.env.local --no-warnings scripts/settle-smoke.mjs",
    "settle:receipt": "node --env-file=.env.local --no-warnings scripts/settle-receipt.mjs",
    "settle:api": "node --env-file=.env.local --no-warnings scripts/settle-api.mjs",
    "groups:e2e": "node --env-file=.env.local --no-warnings scripts/groups-e2e.mjs",
    "wallets:link": "node --env-file=.env.local --no-warnings scripts/link-wallets.mjs",
    "proof": "node --env-file=.env.local --no-warnings scripts/proof.mjs",
    "video:data": "node --env-file=.env.local --no-warnings scripts/video-data.mjs",
    "tatum:smoke": "node --env-file=.env.local scripts/tatum-smoke.mjs",
    "memory:health": "node --env-file=.env.local scripts/memory-health.mjs",
    "memory:roundtrip": "node --env-file=.env.local --no-warnings scripts/memory-roundtrip.mjs",
    "memory:refresh": "node --env-file=.env.local --no-warnings scripts/memory-refresh.mjs",
    "seed:mainnet": "node --env-file=.env.local --no-warnings scripts/seed-mainnet.mjs"
  },
  "devDependencies": {
    "@mysten-incubation/memwal": "0.1.8",
    "@mysten/sui": "2.38.0",
    "fast-check": "4.10.2",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6"
  }
}
