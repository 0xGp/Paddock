# SplitSense: environment variables. Copy to .env.local (never commit real values).
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUI_NETWORK=mainnet
DATABASE_URL=                  # Neon connection string: postgres://…neon.tech/…?sslmode=require

# --- Walrus Memory (MemWal, Mainnet, managed relayer). From memory.walrus.xyz/dashboard ---
MEMWAL_PRIVATE_KEY=            # Ed25519 delegate private key (hex). SERVER ONLY. Never log it.
MEMWAL_ACCOUNT_ID=             # MemWalAccount object ID = the form's "Account ID (SUI)"
MEMWAL_AGENT_ID=               # delegate PUBLIC key (hex) = the form's MEMWAL_AGENT_ID; checked by `pnpm memory:health`
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
NAMESPACE_SALT=                # `openssl rand -hex 32`. Never change it after the first Mainnet write (ADR-0003)

# --- Tatum (Sui gateway, GraphQL only: ADR-0004). From dashboard.tatum.io ---
TATUM_API_KEY=                 # SERVER ONLY. Sent as x-api-key; the browser goes through /api/sui/graphql
TATUM_SUI_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql
TATUM_ACCOUNT_ID=              # "Tatum ID" for the submission form (My Account → My Account Info). Not used at runtime.

# --- Enoki zkLogin (Google). From portal.enoki.mystenlabs.com + Google Cloud console ---
NEXT_PUBLIC_ENOKI_API_KEY=     # Enoki PUBLIC API key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=  # Google OAuth 2.0 Web client ID (…apps.googleusercontent.com)
ENOKI_PRIVATE_API_KEY=         # optional: only if you add Enoki sponsored transactions

# --- Sui / USDC ---
USDC_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC
GROUP_RATE_NGN_PER_USDC=1500   # demo group rate (seeded assumption, not live FX)
STATUS_KNOWN_DIGEST=           # optional: tx digest /status reads back via Tatum; defaults to a public Mainnet USDC transfer
SUI_PAYER_PRIVATE_KEY=         # SCRIPTS ONLY. suiprivkey… for the demo payer; `pnpm sui:keys` creates both wallets
SUI_PAYEE_PRIVATE_KEY=         # SCRIPTS ONLY. suiprivkey… for the demo payee
SUI_ADA_PRIVATE_KEY=           # SCRIPTS ONLY. Receive-only demo wallet for Ada
SUI_TOLU_PRIVATE_KEY=          # SCRIPTS ONLY. Receive-only demo wallet for Tolu

# --- Jobs / admin ---
CRON_SECRET=                   # `openssl rand -hex 32`; Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes
ADMIN_DRAIN_TOKEN=             # `openssl rand -hex 32`; protects POST /api/admin/drain
SESSION_SECRET=                # `openssl rand -hex 32`; signs wallet sign-in cookies. Rotating it signs everyone out
MEMORY_USER_GROUPS=off         # `on` writes settlement receipts of user-created groups to Walrus Mainnet

# --- Judge mode ---
DEMO_GROUP_ID=                 # seeded "Flat 3B" group served read-only at /demo

# --- Optional ---
RESEND_API_KEY=                # email nudges (cut, ADR-0010)
QSTASH_TOKEN=                  # only if minute-level schedules turn out to be needed
